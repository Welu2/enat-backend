# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Addis AI Configuration (Default Voice & LLM Provider)
ADDIS_API_KEY=your-addis-api-key
ADDIS_API_BASE_URL=https://api.addisassistant.com

# Sahara / Intron Voice API Configuration (Alternative Voice Provider)
# Accepts INTRON_API_KEY or SAHARA_API_KEY
INTRON_API_KEY=your-intron-voice-api-key
INTRON_API_BASE_URL=https://infer.voice.intron.io

# Google Gemini API Configuration (Alternative Voice Transcription Provider)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ElevenLabs Configuration (Alternative English Voice Provider - TTS & STT)
# Accepts ELEVENLABS_API_KEY or XI_API_KEY
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v1

# Deepgram Configuration (Alternative English Voice Provider - TTS & STT)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_API_BASE_URL=https://api.deepgram.com
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# App & CORS Configuration
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_DEV_ROUTES=true
REMINDER_CRON_HOUR=6

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=

# Python 3.12; copy to .env and supply project-specific values.
ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=
ADDIS_API_KEY=replace-with-addis-api-key
ADDIS_API_BASE_URL=https://api.addisassistant.com
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TELEGRAM_BOT_TOKEN=
ENABLE_DEV_ROUTES=false
PROCESS_ROLE=api
# Obsolete flag: true is rejected in every environment.
ENABLE_EMBEDDED_SCHEDULER=false
REMINDER_CRON_HOUR=6

# Patient tables use this non-owner, non-BYPASSRLS PostgreSQL role, not Storage credentials.
DATABASE_URL=postgresql://enat_app:replace-password@db.example.org:5432/postgres?sslmode=verify-full
# Scheduler/worker only: never supply this credential to API deployments.
WORKER_DATABASE_URL=
# Supabase publishable/anon key is used only for Auth REST requests.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Optional migration deadline, e.g. an explicitly approved UTC timestamp within 30 days.
# HS256 is rejected by default; even during migration Auth verifies every token.
LEGACY_HS256_UNTIL=
TELEGRAM_MAX_AGE_SECONDS=300
TELEGRAM_CLOCK_SKEW_SECONDS=30
ENABLE_SUMMARY_SHARING=false
ENABLE_REQUEST_LIMITS=true
RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TRUSTED_HOSTS=localhost,127.0.0.1
# scripts/run_api.sh: explicit edge proxy addresses, never '*'.
TRUSTED_PROXY_IPS=127.0.0.1
MAX_REQUEST_BYTES=8000000
MAX_AUDIO_BYTES=6000000
MAX_AUDIO_SECONDS=120
PROVIDER_DAILY_USER_CALLS=100
PROVIDER_DAILY_GLOBAL_CALLS=10000
PROVIDER_CONCURRENCY=20
PROVIDER_OPERATION_SECONDS=45
PROVIDER_REQUEST_SECONDS=20
IO_THREAD_LIMIT=16
DATABASE_POOL_SIZE=10
WORKER_POOL_SIZE=4
# Private metrics exporter; use a new random value per environment.
METRICS_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Private OTLP/HTTP collector. Empty disables trace export; set in deployed environments.
OTLP_ENDPOINT=

# Enable only after assigning the privacy request queue owner and approved policy.
ENABLE_PRIVACY_TOOLS=false
PRIVACY_POLICY_VERSION=
PRIVACY_SUPPORT_URL=

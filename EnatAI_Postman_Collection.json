                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkin/{{session_id}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkin",
                "{{session_id}}",
                "complete"
              ]
            },

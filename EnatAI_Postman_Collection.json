                "{{baseUrl}}"
              ],
              "path": [
                "checkin",
                "{{session_id}}",
                "items",
                "{{item_id}}",
                "voice-correct"
              ]
            },
            "description": "Re-records voice for a specific pending item."
          }
        },
        {

          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkin/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkin",
                "start"
              ]
